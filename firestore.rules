rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: check if the caller is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Products: public read, admin-only write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can create (submit order), admin can read/update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Bookings: anyone can create, admin can read/update/delete
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: anyone can create, admin can read/update/delete
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
